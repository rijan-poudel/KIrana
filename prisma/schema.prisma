datasource db {
  provider = "sqlite"
  url      = "file:./shop.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id               String            @id @default(cuid())
  name             String
  category         String
  barcode          String?           @unique
  retailPrice      Float             // price per base unit
  wholesalePrice   Float             // price per base unit
  costPrice        Float             @default(0) // purchase cost per base unit, for profit reports
  sellAs           String            @default("BOTH") // RETAIL | WHOLESALE | BOTH — who this item is sold to
  stockQuantity    Float             // always tracked in base units
  baseUnit         String            @default("pcs") // pcs, kg, liter — the unit stock is counted in
  lowStockAt       Float             @default(10) // per-product low-stock threshold (base units)
  manufacturingDate DateTime?       // when this batch was manufactured
  expiryDate        DateTime?       // when this batch expires
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  units            ProductUnit[]
  transactionItems TransactionItem[]
  stockMoves       StockMove[]
  deliveryItems    DeliveryItem[]
}

/// A sellable pack size above/below the base unit: "Carton" ×30 pcs, "Dozen" ×12, "gram" ×0.001…
model ProductUnit {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // Carton, Pack, Dozen, Bora, gram…
  factor    Float // base units contained in 1 of this unit
  @@unique([productId, name])
}

/// Append-only stock ledger: every gain or loss of stock gets one row.
model StockMove {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Float // change in BASE units (+ bought, − sold/damaged)
  reason    String // PURCHASE, SALE, DAMAGE, RETURN, ADJUST, COUNT, OPENING
  note      String?
  unitName  String? // unit the quantity was entered in, for display
  quantity  Float? // amount as entered in unitName
  refType   String? // TRANSACTION, DELIVERY
  refId     String?
  createdAt DateTime @default(now())
}

model Customer {
  id             String        @id @default(cuid())
  name           String
  phone          String?
  address        String        // e.g., Gaindakot Ward No...
  currentBalance Float         @default(0.0) // Total active udharo/credit owed
  isFavorite     Boolean       @default(false) // regulars the shopkeeper wants one tap away
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  deliveries     DeliveryLog[]
}

model Transaction {
  id             String            @id @default(cuid())
  customerId     String?           // Nullable for cash walk-ins
  type           String            // 'RETAIL' or 'WHOLESALE'
  totalAmount    Float             // net of any discount
  discountAmount Float             @default(0) // bhaansi given off this bill, in rupees
  discountNote   String?           // e.g. "5% bhaansi" or why the discount was given
  paidAmount     Float
  paymentStatus  String            // 'PAID', 'UDHARO', 'PARTIAL'
  createdAt      DateTime          @default(now())
  customer       Customer?         @relation(fields: [customerId], references: [id])
  items          TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  quantity      Float       // in BASE units
  unitName      String      @default("") // unit the customer was billed in (display); "" = product base unit
  unitPrice     Float       // price per base unit at sale time
  subtotal      Float
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])
}

model DeliveryLog {
  id                String        @id @default(cuid())
  driverName        String
  driverPhone       String?
  vehicleNumber     String?
  destinationClient String
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  scheduledAt       DateTime?
  startedAt         DateTime?
  deliveredAt       DateTime?
  itemsSummary      String
  totalValue        Float
  status            String        // 'PENDING', 'ASSIGNED', 'LOADED', 'IN_TRANSIT', 'DELIVERED', 'SETTLED', 'RETURNED', 'CANCELLED'
  proofOfDelivery   String?
  deliveryNotes     String?
  settlementNotes   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             DeliveryItem[]

  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
}

model DeliveryItem {
  id            String       @id @default(cuid())
  deliveryLogId String
  deliveryLog   DeliveryLog  @relation(fields: [deliveryLogId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  quantity      Float        // in base units
  unitName      String       // unit billed in
  unitPrice     Float        // price at delivery time
  subtotal      Float
}

/// A bill the shop RECEIVES (purchases) — the permanent paper trail for the
/// accountant and VAT filing. VAT bills carry the vendor PAN + bill number the
/// CBMS system keys on. The QR payload is a few hundred bytes, so the record
/// itself is tiny; photos are optional extras stored on disk, not here.
model PurchaseBill {
  id            String    @id @default(cuid())
  vendorName    String
  vendorPan     String? // 9-digit PAN of the seller, printed on the bill / in the QR
  billNumber    String
  billDateBs    String? // date exactly as printed on the bill, Bikram Sambat, e.g. "2082.05.12"
  billDateAd    DateTime? // Gregorian date when known (printed on the bill or typed by hand)
  fiscalYear    String? // derived from billDateBs, e.g. "2082/83" — how VAT filing is organized
  taxableAmount Float     @default(0) // net taxable sales, before VAT
  vatAmount     Float     @default(0) // 13% input VAT charged by the vendor
  totalAmount   Float     @default(0) // what the bill says to pay
  isVatBill     Boolean   @default(false) // false for plain kachcha bills with no VAT line
  source        String    @default("QR") // QR | MANUAL
  rawPayload    String? // the exact QR text — the verifiable original, kept forever
  photoPath     String? // optional compressed photo on disk (data/bill-photos/), prunable
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([vendorPan, billNumber]) // one record per physical bill; NULL PANs are exempt
  @@index([createdAt])
  @@index([isVatBill])
}
